# Sharehouse Manager - Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Australia/Perth

# Cron Secret (for secure cron job endpoints)
CRON_SECRET=your_random_secret_string_min_32_chars

# Optional: Email notifications (future)
# RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM=noreply@yourdomain.com
